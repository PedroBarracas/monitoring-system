# Notification channel: "telegram" or "discord"
NOTIFICATION_CHANNEL=telegram

# Telegram (required if NOTIFICATION_CHANNEL=telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord (required if NOTIFICATION_CHANNEL=discord)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Products (JSON array of target configs)
# Minimal: [{"url":"https://example.com/products"}]
# With CSS selectors: [{"url":"https://example.com","extractor":"css","selectors":{...}}]
PRODUCT_TARGETS=[{"url":"https://example.com/new-arrivals"}]
PRODUCT_CONCURRENCY=5
# Consecutive cycles a product must be absent before it's marked removed
PRODUCT_REMOVAL_THRESHOLD=3
# Override the static currency->EUR rate table (JSON), e.g. {"GBP":1.25,"USD":0.93}
# CURRENCY_RATES_EUR={"GBP":1.17}

# Schedule
CRON_EXPRESSION=*/30 * * * *

# Database
DB_PATH=./data/monitoring.db

# Logging
LOG_LEVEL=info

# Proxy (optional) — store fetches that hit 403/429/503 or a network error are
# retried through this proxy. Leave unset to disable.
# PROXY_URL=http://user:pass@host:port
